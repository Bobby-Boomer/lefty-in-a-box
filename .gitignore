# Never commit the heavy or the private
.venv/
node_modules/
models/
*.mp3
*.wav
*.pt
*.bin
.env
.DS_Store
chrome-profile/

# Voice line runtime — never ship a key, a model, or a live state file
voice-line/.env
voice-line/.venv/
voice-line/uv.lock
voice-line/.voice_state
voice-line/.voice_waveform
voice-line/.voice_alert
voice-line/.voice_line.lock
voice-line/.voice_loading_pid
voice-line/crash.log
__pycache__/
*.pyc

# Personal choices, not shipped defaults. install/personalize.sh writes this.
lefty.config.json

# The agent's boot file, written by install/finish-setup.sh at the end of setup.
# Theirs to edit, and gitignored so `git pull` never fights with it.
agent.md
